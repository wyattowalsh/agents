{
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "cwd": ".",
            "comment": "Block high-risk shell commands.",
            "command": "./hooks/guard-destructive.sh",
            "timeout": 5000
          }
        ],
        "_apm_source": "_local/agents"
      },
      {
        "hooks": [
          {
            "type": "command",
            "cwd": ".",
            "comment": "Block edits to protected paths and secret-bearing files.",
            "command": "./hooks/protect-files.sh",
            "timeout": 5000
          }
        ],
        "_apm_source": "_local/agents"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook git-commit-push-guard --harness gemini-cli",
            "name": "git-commit-push-guard",
            "timeout": 5000,
            "description": "Block force-pushes to protected branches, hook-skipping commits, and unsafe history rewrites across the fleet."
          }
        ],
        "sequential": true,
        "matcher": "Bash|bash|run_shell_command|shell|terminal"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook image-input-optimizer-guard --harness gemini-cli",
            "name": "image-input-optimizer-guard",
            "timeout": 60000,
            "description": "Resize and compress oversized local image inputs before harnesses consume them."
          }
        ],
        "sequential": true,
        "matcher": "analyze_image|attach_image|screenshot|upload_image|view_image|Read|read"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-readonly-write-guard --harness gemini-cli",
            "name": "research-readonly-write-guard",
            "timeout": 5000,
            "description": "Prevent source-file write tools during active research sessions."
          }
        ],
        "sequential": true,
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|run_shell_command"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-dangerous-shell-guard --harness gemini-cli",
            "name": "research-dangerous-shell-guard",
            "timeout": 5000,
            "description": "Block dangerous shell side effects during active research sessions."
          }
        ],
        "sequential": true,
        "matcher": "Bash|bash|run_shell_command"
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "cwd": ".",
            "comment": "Run best-effort formatter after edits.",
            "command": "./hooks/auto-format.sh",
            "timeout": 60000
          }
        ],
        "_apm_source": "_local/agents"
      },
      {
        "hooks": [
          {
            "type": "command",
            "cwd": ".",
            "comment": "Return concise lint/type context after edits.",
            "command": "./hooks/lint-check.sh",
            "timeout": 30000
          }
        ],
        "_apm_source": "_local/agents"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-evidence-ledger --harness gemini-cli",
            "name": "research-evidence-ledger",
            "timeout": 5000,
            "description": "Append lightweight provenance metadata for research retrieval tools."
          }
        ],
        "sequential": true,
        "matcher": "WebSearch|web_search|fetch|fetcher|trafilatura|docling|mcp__.*|mcp_.*"
      }
    ],
    "sessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "cwd": ".",
            "comment": "Report basic session environment and repository state.",
            "command": "./hooks/session-start.sh",
            "timeout": 15000
          }
        ],
        "_apm_source": "_local/agents"
      }
    ],
    "userPromptSubmitted": [
      {
        "hooks": [
          {
            "type": "command",
            "cwd": ".",
            "comment": "Write local prompt audit entries with short retention.",
            "command": "./hooks/log-prompt.sh",
            "timeout": 5000
          }
        ],
        "_apm_source": "_local/agents"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/verify-before-stop.sh",
            "timeout": 60
          }
        ],
        "_apm_source": "_local/agents"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/task-completed-gate.sh",
            "timeout": 120
          }
        ],
        "_apm_source": "_local/agents"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/teammate-idle-gate.sh",
            "timeout": 120
          }
        ],
        "_apm_source": "_local/agents"
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-prompt-triage-context --harness gemini-cli",
            "name": "research-prompt-triage-context",
            "timeout": 5000,
            "description": "Activate research hook state and inject research-method reminders."
          }
        ],
        "sequential": true
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-stop-verifier --harness gemini-cli",
            "name": "research-stop-verifier",
            "timeout": 30000,
            "description": "Verify research skill invariants before an active research session completes."
          }
        ],
        "sequential": true
      }
    ]
  }
}
