---
/**
 * Searchable, progressively rendered catalog for large external skill lists.
 * Avoids mounting hundreds of LinkCard nodes on first paint.
 */

interface SkillRow {
  name: string;
  description?: string;
  status?: string;
  sourceType?: string;
}

interface Props {
  skills?: SkillRow[];
  src?: string;
  indexKey?: string;
  pageSize?: number;
}

const { skills = [], src = '', indexKey = 'externalSkillIndex', pageSize = 48 } = Astro.props;

const laneByStatus: Record<string, string> = {
  'install-now-after-trust-gate': 'install-now',
  'inspect-then-install': 'inspect',
  'global-only-or-avoid': 'avoid',
};

const serializeSkill = (skill: SkillRow) => ({
  name: skill.name,
  description: (skill.description || '').slice(0, 160),
  href: `/skills/catalog/external/${encodeURIComponent(skill.name)}/`,
  lane: laneByStatus[String(skill.status || '')] || 'inspect',
  sourceType: skill.sourceType || 'curated-external',
});

const serialized = skills.map(serializeSkill);
---

<div class="catalog-browser" data-catalog-browser data-page-size={pageSize} data-catalog-src={src} data-catalog-index-key={indexKey}>
  <div class="catalog-browser__toolbar" role="toolbar" aria-label="Browse external skills">
    <label class="catalog-browser__search">
      <span class="sr-only">Search external skills</span>
      <input
        type="search"
        class="catalog-browser__input"
        placeholder="Search by name or description…"
        autocomplete="off"
        spellcheck="false"
        data-catalog-search
      />
    </label>
    <div class="catalog-browser__filters" role="group" aria-label="Filter by trust lane">
      <button type="button" class="catalog-browser__filter is-active" data-lane="all" aria-pressed="true">All</button>
      <button type="button" class="catalog-browser__filter" data-lane="install-now" aria-pressed="false">Install now</button>
      <button type="button" class="catalog-browser__filter" data-lane="inspect" aria-pressed="false">Inspect</button>
      <button type="button" class="catalog-browser__filter" data-lane="avoid" aria-pressed="false">Avoid</button>
    </div>
  </div>

  <p class="catalog-browser__meta" data-catalog-meta aria-live="polite"></p>

  <div class="catalog-browser__grid" data-catalog-grid></div>
  <noscript>
    {serialized.length > 0 ? (
      <>
        <p class="catalog-browser__meta">Showing the first {Math.min(serialized.length, pageSize)} external skills. Enable JavaScript to search and filter the full catalog.</p>
        <div class="catalog-browser__grid">
          {serialized.slice(0, pageSize).map((skill) => (
            <article class="catalog-browser__card sl-link-card">
              <a class="catalog-browser__card-link sl-link-card__link" href={skill.href}>
                <span class="catalog-browser__card-title sl-link-card__title">{skill.name}</span>
                <span class="catalog-browser__card-desc sl-link-card__description">{skill.description}</span>
              </a>
            </article>
          ))}
        </div>
      </>
    ) : (
      <p class="catalog-browser__meta">Enable JavaScript to load, search, and filter the external skill catalog.</p>
    )}
  </noscript>

  <div class="catalog-browser__footer">
    <button type="button" class="catalog-browser__more" data-catalog-more hidden>Load more</button>
  </div>
</div>

<script is:inline define:vars={{ serialized, src, indexKey, pageSize }}>
  const root = document.querySelector('[data-catalog-browser]');
  if (!root) {
    // no-op when component is not mounted
  } else {
    let skills = serialized;
    const grid = root.querySelector('[data-catalog-grid]');
    const meta = root.querySelector('[data-catalog-meta]');
    const searchInput = root.querySelector('[data-catalog-search]');
    const moreBtn = root.querySelector('[data-catalog-more]');
    const filterButtons = root.querySelectorAll('[data-lane]');

    let activeLane = 'all';
    let query = '';
    let visibleCount = pageSize;
    let filtered = skills;
    let loadError = '';

    const normalize = (value) => String(value || '').toLowerCase();
    const normalizeSkill = (skill) => {
      const name = String(skill?.name || '');
      return {
        name,
        description: String(skill?.description || '').slice(0, 160),
        href: `/skills/catalog/external/${encodeURIComponent(name)}/`,
        lane: {
          'install-now-after-trust-gate': 'install-now',
          'inspect-then-install': 'inspect',
          'global-only-or-avoid': 'avoid',
        }[String(skill?.status || '')] || 'inspect',
        sourceType: skill?.sourceType || 'curated-external',
      };
    };

    const applyFilters = () => {
      const needle = normalize(query);
      filtered = skills.filter((skill) => {
        const laneMatch = activeLane === 'all' || skill.lane === activeLane;
        if (!laneMatch) return false;
        if (!needle) return true;
        return normalize(skill.name).includes(needle) || normalize(skill.description).includes(needle);
      });
      visibleCount = pageSize;
    };

    const renderCard = (skill) => {
      const article = document.createElement('article');
      article.className = 'catalog-browser__card sl-link-card';

      const link = document.createElement('a');
      link.className = 'catalog-browser__card-link sl-link-card__link';
      link.href = skill.href;

      const title = document.createElement('span');
      title.className = 'catalog-browser__card-title sl-link-card__title';
      title.textContent = skill.name;

      const description = document.createElement('span');
      description.className = 'catalog-browser__card-desc sl-link-card__description';
      description.textContent = skill.description || '';

      link.append(title, description);
      article.append(link);
      return article;
    };

    const render = () => {
      if (!(grid instanceof HTMLElement) || !(meta instanceof HTMLElement)) return;
      grid.replaceChildren();
      const slice = filtered.slice(0, visibleCount);
      for (const skill of slice) {
        grid.appendChild(renderCard(skill));
      }
      const showing = slice.length;
      const total = filtered.length;
      meta.textContent =
        total === 0 && loadError
          ? loadError
          : total === 0
            ? 'No skills match the current filters.'
            : `Showing ${showing} of ${total} external skill${total === 1 ? '' : 's'}.`;
      if (moreBtn instanceof HTMLButtonElement) {
        const hasMore = showing < total;
        moreBtn.hidden = !hasMore;
        moreBtn.disabled = !hasMore;
      }
    };

    const setLane = (lane) => {
      activeLane = lane;
      for (const btn of filterButtons) {
        if (!(btn instanceof HTMLButtonElement)) continue;
        const active = btn.dataset.lane === lane;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      }
      applyFilters();
      render();
    };

    if (searchInput instanceof HTMLInputElement) {
      searchInput.addEventListener('input', () => {
        query = searchInput.value;
        applyFilters();
        render();
      });
    }

    for (const btn of filterButtons) {
      btn.addEventListener('click', () => {
        if (!(btn instanceof HTMLButtonElement)) return;
        setLane(btn.dataset.lane || 'all');
      });
    }

    if (moreBtn instanceof HTMLButtonElement) {
      moreBtn.addEventListener('click', () => {
        visibleCount += pageSize;
        render();
      });
    }

    applyFilters();
    render();

    if (src) {
      if (meta instanceof HTMLElement) {
        meta.textContent = skills.length > 0 ? 'Refreshing external skill catalog...' : 'Loading external skill catalog...';
      }
      fetch(src)
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          return response.json();
        })
        .then((data) => {
          const rows = Array.isArray(data) ? data : Array.isArray(data?.[indexKey]) ? data[indexKey] : [];
          skills = rows.map(normalizeSkill).filter((skill) => skill.name);
          loadError = '';
          applyFilters();
          render();
        })
        .catch(() => {
          loadError =
            skills.length > 0
              ? 'Using preview data; unable to refresh the generated catalog index.'
              : 'Unable to load the generated catalog index.';
          applyFilters();
          render();
        });
    }
  }
</script>

<style>
  .catalog-browser {
    margin: 1rem 0 2rem;
  }
  .catalog-browser__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .catalog-browser__search {
    flex: 1 1 16rem;
    min-width: 12rem;
  }
  .catalog-browser__input {
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    color: var(--sl-color-text);
    border-radius: var(--radius-md, 0.5rem);
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
  }
  .catalog-browser__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .catalog-browser__filter {
    border: 1px solid var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-text);
    border-radius: var(--radius-pill, 999px);
    padding: 0.35rem 0.85rem;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .catalog-browser__filter.is-active,
  .catalog-browser__filter:hover {
    border-color: var(--primary);
    color: var(--sl-color-text-accent);
  }
  .catalog-browser__meta {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }
  .catalog-browser__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  .catalog-browser__card {
    border: 1px solid var(--sl-color-gray-6);
    border-radius: var(--radius-md, 0.5rem);
    padding: 0;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .catalog-browser__card:hover {
    border-color: var(--primary);
    transform: translateY(-1px);
  }
  .catalog-browser__card-link {
    display: block;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
  }
  .catalog-browser__card-title {
    display: block;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .catalog-browser__card-desc {
    display: block;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    line-height: 1.45;
  }
  .catalog-browser__footer {
    margin-top: 1rem;
    text-align: center;
  }
  .catalog-browser__more {
    border: 1px solid var(--sl-color-gray-5);
    background: transparent;
    color: var(--sl-color-text);
    border-radius: var(--radius-pill, 999px);
    padding: 0.45rem 1.1rem;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .catalog-browser__more:hover {
    border-color: var(--primary);
    color: var(--sl-color-text-accent);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
