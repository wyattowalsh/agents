---
interface Props {
  src: string;
  scripts?: InstallScriptsData;
}

interface InstallCommandItem {
  command?: string;
  source?: string;
  status?: string;
  trustTier?: string;
  skills?: string[];
}

interface InstallScriptsData {
  customAll?: string;
  customIndividual?: InstallCommandItem[];
  externalCommands?: InstallCommandItem[];
  installedCommands?: InstallCommandItem[];
  syncDryRun?: string;
  syncApply?: string;
}

interface CommandBlock {
  command: string;
  title: string;
  note?: string;
}

const { src, scripts } = Astro.props;

const compact = (values: Array<string | undefined>) => values.filter(Boolean) as string[];
const noteForCommand = (item: InstallCommandItem) =>
  compact([
    item.status,
    item.trustTier,
    Array.isArray(item.skills) && item.skills.length ? `Installs: ${item.skills.slice().sort().join(', ')}` : undefined,
  ]).join(' | ');

const customCommands = Array.isArray(scripts?.customIndividual)
  ? scripts.customIndividual.map((item) => item.command).filter(Boolean).join('\n')
  : '';
const externalCommands = [...(scripts?.externalCommands ?? []), ...(scripts?.installedCommands ?? [])];
const commandGroups: Array<{ heading: string; commands: CommandBlock[] }> = [
  {
    heading: 'Custom Skills',
    commands: scripts?.customAll ? [{ command: scripts.customAll, title: 'Install all custom skills' }] : [],
  },
  {
    heading: 'Reconcile Repo + External Skills',
    commands:
      scripts?.syncDryRun || scripts?.syncApply
        ? [
            {
              command: compact([scripts?.syncDryRun, scripts?.syncApply]).join('\n'),
              title: 'Preview or apply repo reconciliation',
            },
          ]
        : [],
  },
  {
    heading: 'External Skill Commands',
    commands: externalCommands
      .filter((item) => item.command)
      .map((item) => ({
        command: String(item.command),
        title: String(item.source ?? 'External skill command'),
        note: noteForCommand(item),
      })),
  },
  {
    heading: 'Individual Custom Skills',
    commands: customCommands ? [{ command: customCommands, title: 'Install individual custom skills' }] : [],
  },
];
const hasServerScripts = commandGroups.some((group) => group.commands.length > 0);
---

<section class="install-scripts" data-install-scripts data-install-scripts-src={src}>
  <p class="skill-catalog__count" data-install-scripts-status>
    {hasServerScripts ? 'Install scripts ready.' : 'Loading install scripts...'}
  </p>
  <div data-install-scripts-root>
    {commandGroups.map((group) => group.commands.length > 0 && (
      <>
        <h2>{group.heading}</h2>
        {group.commands.map((item) => (
          <section class="install-command">
            <div class="install-command__header">
              <div>
                <p>{item.title}</p>
                {item.note && <span>{item.note}</span>}
              </div>
              <button type="button" class="install-command__copy" aria-label={`Copy install command: ${item.title}`}>
                Copy
              </button>
            </div>
            <pre class="agents-scrollbar"><code>{item.command}</code></pre>
          </section>
        ))}
      </>
    ))}
  </div>
  <noscript>
    <p class="skill-catalog__count">
      The generated install command JSON is also available at <a href={src}>{src}</a>.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll('[data-install-scripts]').forEach((catalog) => {
    const src = catalog.getAttribute('data-install-scripts-src');
    const status = catalog.querySelector('[data-install-scripts-status]');
    const root = catalog.querySelector<HTMLElement>('[data-install-scripts-root]');
    const hasServerContent = root instanceof HTMLElement && root.children.length > 0;

    const escapeHtml = (value: unknown) =>
      String(value ?? '').replace(/[&<>"']/g, (char) => {
        const escapes: Record<string, string> = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        };
        return escapes[char] ?? char;
      });

    const commandBlock = (command: string, title: string, note = '') => `
      <section class="install-command">
        <div class="install-command__header">
          <div>
            <p>${escapeHtml(title)}</p>
            ${note ? `<span>${escapeHtml(note)}</span>` : ''}
          </div>
          <button type="button" class="install-command__copy" aria-label="Copy install command: ${escapeHtml(title)}">Copy</button>
        </div>
        <pre class="agents-scrollbar"><code>${escapeHtml(command)}</code></pre>
      </section>`;

    const groupedCommands = (title: string, commands: any[]) => {
      if (!commands?.length) return '';
      const body = commands
        .map((item) => {
          const skills = Array.isArray(item.skills) ? item.skills.slice().sort().join(', ') : '';
          const note = [item.status, item.trustTier, skills ? `Installs: ${skills}` : ''].filter(Boolean).join(' | ');
          return commandBlock(String(item.command ?? ''), String(item.source ?? title), note);
        })
        .join('');
      return `<h2>${escapeHtml(title)}</h2>${body}`;
    };

    const hydrate = async () => {
      if (!src || !root) return;
      const response = await fetch(src);
      const scripts = await response.json();
      const customCommands = Array.isArray(scripts.customIndividual)
        ? scripts.customIndividual.map((item: any) => item.command).filter(Boolean).join('\n')
        : '';
      root.innerHTML = [
        '<h2>Custom Skills</h2>',
        commandBlock(String(scripts.customAll ?? ''), 'Install all custom skills'),
        '<h2>Reconcile Repo + External Skills</h2>',
        commandBlock([scripts.syncDryRun, scripts.syncApply].filter(Boolean).join('\n'), 'Preview or apply repo reconciliation'),
        groupedCommands('External Skill Commands', [
          ...(scripts.externalCommands ?? []),
          ...(scripts.installedCommands ?? []),
        ]),
        '<h2>Individual Custom Skills</h2>',
        commandBlock(customCommands, 'Install individual custom skills'),
      ].join('');
      if (status) status.textContent = 'Install scripts loaded.';
    };

    hydrate().catch(() => {
      if (status) {
        status.textContent = hasServerContent
          ? 'Using embedded install scripts; unable to refresh generated JSON.'
          : 'Unable to load install scripts.';
      }
    });
  });
</script>
