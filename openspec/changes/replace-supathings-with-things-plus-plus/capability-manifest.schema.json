{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w4w.dev/schemas/things-plus-plus-capability-manifest.schema.json",
  "title": "Things++ capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeId",
    "group",
    "counts",
    "naming",
    "scopes",
    "invariants",
    "netNewOutcomeIds",
    "tools",
    "supaOutcomes",
    "workflows",
    "legacyEvals",
    "newEvals",
    "upstreamCoreProvenance",
    "schemaHashLifecycle",
    "f0ObservedPrerequisites"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "changeId": {
      "const": "replace-supathings-with-things-plus-plus"
    },
    "group": {
      "type": "object",
      "required": [
        "name",
        "deterministicId",
        "localPath",
        "remotePath",
        "localResource",
        "remoteResource",
        "servers"
      ],
      "properties": {
        "name": {
          "const": "things"
        },
        "deterministicId": {
          "const": "3b94a096-b95f-586c-b2e7-e69ed177eb5a"
        },
        "localPath": {
          "const": "/mcp/things"
        },
        "remotePath": {
          "const": "/mcp/things"
        },
        "localResource": {
          "const": "http://127.0.0.1:46683/mcp/things"
        },
        "remoteResource": {
          "const": "https://mcp.w4w.dev/mcp/things"
        },
        "servers": {
          "const": [
            "things-core",
            "things-shortcuts",
            "things-native"
          ]
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "const": {
        "tools": 70,
        "coreTools": 41,
        "shortcutTools": 21,
        "nativeTools": 8,
        "supaOutcomes": 37,
        "workflows": 17,
        "legacyEvalIds": 25,
        "newEvalIds": 16
      }
    },
    "naming": {
      "type": "object",
      "required": [
        "normalization",
        "publicRule",
        "collisionRule",
        "callRouting",
        "schemaHashRule"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "scopes": {
      "type": "object",
      "required": [
        "independent",
        "implication",
        "chatgptRequiredGrant",
        "catalogAccessRule"
      ],
      "properties": {
        "independent": {
          "const": [
            "things.read",
            "things.write",
            "things.admin"
          ]
        },
        "implication": {
          "const": "none"
        },
        "chatgptRequiredGrant": {
          "const": [
            "things.read",
            "things.write",
            "things.admin"
          ]
        },
        "catalogAccessRule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "object",
      "required": [
        "exactToolUnion",
        "zeroRemoved",
        "zeroUnmapped",
        "netNewGreaterThanZero",
        "oneThingsGroupOnly",
        "futureCapabilityChangeRequiresOpenSpecRevision"
      ],
      "additionalProperties": {
        "const": true
      }
    },
    "netNewOutcomeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tools": {
      "type": "array",
      "minItems": 70,
      "maxItems": 70,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "server",
          "serverToolName",
          "publicToolName",
          "expectedMcphubQualifiedName",
          "qualifiedCapabilityId",
          "minimumIndependentScope",
          "risk",
          "annotations",
          "backendPrerequisites",
          "schemaContractId",
          "adaptedSchemaHashes",
          "testIds",
          "implementationKind"
        ],
        "properties": {
          "server": {
            "enum": [
              "things-core",
              "things-shortcuts",
              "things-native"
            ]
          },
          "serverToolName": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "publicToolName": {
            "type": "string",
            "pattern": "^things_(core|shortcuts|native)__[a-z][a-z0-9_]*$"
          },
          "expectedMcphubQualifiedName": {
            "type": "string",
            "pattern": "^things_(core|shortcuts|native)__[a-z][a-z0-9_]*$"
          },
          "qualifiedCapabilityId": {
            "type": "string",
            "pattern": "^things-(core|shortcuts|native)/[a-z][a-z0-9_]*$"
          },
          "minimumIndependentScope": {
            "enum": [
              "things.read",
              "things.write",
              "things.admin"
            ]
          },
          "risk": {
            "enum": [
              "read-only",
              "ui-visible",
              "ui-visible-write",
              "single-write",
              "bulk-write",
              "destructive-write",
              "maintenance",
              "ui-handoff"
            ]
          },
          "annotations": {
            "type": "object",
            "required": [
              "readOnlyHint",
              "destructiveHint",
              "idempotentHint",
              "openWorldHint"
            ],
            "additionalProperties": false,
            "properties": {
              "readOnlyHint": { "type": "boolean" },
              "destructiveHint": { "type": "boolean" },
              "idempotentHint": { "type": "boolean" },
              "openWorldHint": { "type": "boolean" }
            }
          },
          "backendPrerequisites": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "schemaContractId": {
            "type": "string",
            "minLength": 1
          },
          "testIds": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "implementationKind": {
            "enum": [
              "upstream-security-adapter",
              "fixed-shortcut-protocol",
              "fixed-applescript",
              "fixed-things-url-scheme"
            ]
          },
          "auditedUpstreamSchemaHashes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputSchemaSha256",
              "outputSchemaSha256"
            ],
            "properties": {
              "inputSchemaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "outputSchemaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "adaptedSchemaHashes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputSchemaSha256",
              "outputSchemaSha256",
              "status"
            ],
            "properties": {
              "inputSchemaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "outputSchemaSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "status": {
                "const": "frozen"
              }
            }
          },
          "constraints": {
            "type": "object"
          },
          "mutationReceiptPolicy": {
            "const": "exempt-ui-handoff-no-server-mutation"
          },
          "undoPolicy": {
            "const": "non-undoable"
          },
          "cascadePreview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "childCountRequired"
            ],
            "properties": {
              "required": {
                "const": true
              },
              "childCountRequired": {
                "const": true
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "server": {
                  "const": "things-core"
                }
              },
              "required": [
                "server"
              ]
            },
            "then": {
              "required": [
                "auditedUpstreamSchemaHashes"
              ]
            }
          }
        ]
      }
    },
    "supaOutcomes": {
      "type": "array",
      "minItems": 37,
      "maxItems": 37,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "supaToolName",
          "mappingKind",
          "targetCapabilityIds",
          "workflowIds",
          "status",
          "testIds"
        ],
        "properties": {
          "supaToolName": {
            "type": "string",
            "minLength": 1
          },
          "mappingKind": {
            "enum": [
              "direct",
              "composed",
              "safe-replacement",
              "semantic"
            ]
          },
          "targetCapabilityIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^things-(core|shortcuts|native)/"
            }
          },
          "workflowIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "const": "mapped"
          },
          "testIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflowId",
          "targetCapabilityIds",
          "status",
          "testIds"
        ],
        "properties": {
          "workflowId": {
            "type": "string",
            "minLength": 1
          },
          "targetCapabilityIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^things-(core|shortcuts|native)/"
            }
          },
          "status": {
            "const": "mapped"
          },
          "testIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "legacyEvals": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "legacyEvalId",
          "replacementEvalId",
          "status",
          "testIds"
        ],
        "properties": {
          "legacyEvalId": {
            "type": "string",
            "minLength": 1
          },
          "replacementEvalId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "rewrite-required"
          },
          "testIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "newEvals": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evalId",
          "purpose",
          "testIds"
        ],
        "properties": {
          "evalId": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "testIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "upstreamCoreProvenance": {
      "const": {
        "package": "mcp-server-things",
        "version": "1.9.0",
        "wheelSha256": "720f27aaabe76c3daddd2d92d4fd15bed0111b9eb390dca4b56284f950b9ce2c",
        "sdistSha256": "99a6f630a0b80fe12a95ccf36a727b1dbc667ce60a6cc30ad1d391f4071e9bd0",
        "recordSha256": "e44727b7595a2b618118a060e5871e02065999152404055c68301613e49a1be7",
        "recordEntriesVerified": 48,
        "recordEntriesTotal": 48,
        "orderedToolNamesSha256": "6e7d22b09f4966cde99954cb37f7e5ce4566adab9d9733b75afa1ead7580efd4",
        "sortedToolNamesSha256": "4208486cfdd749c791586ef4158e63b5fbdefcecff91cb110f6cdafe9dba8f89",
        "canonicalSchemaEncoding": "UTF-8 JSON with sorted keys and compact separators",
        "commonOutputSchemaSha256": "82ef96cebaf5fbe16269fd18b0240d78f5b9b90a4155a17eb797115b09148ecf"
      }
    },
    "schemaHashLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditedUpstream",
        "adapted",
        "futureChangeRule"
      ],
      "properties": {
        "auditedUpstream": {
          "type": "string",
          "minLength": 1
        },
        "adapted": {
          "type": "string",
          "minLength": 1
        },
        "futureChangeRule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "f0ObservedPrerequisites": {
      "const": {
        "shortcutBridges": {
          "fixedNames": [
            "Things++ Agent Bridge",
            "Things++ Destructive Bridge"
          ],
          "observedStatus": "absent",
          "tccStatus": "unproven",
          "sourceImplementationMayProceed": true,
          "liveActivationAllowed": false
        },
        "currentRuntime": {
          "status": "temporally-inconsistent-stale",
          "useAsCutoverEvidence": false,
          "freshProvenanceRequiredImmediatelyBeforeCutover": true
        }
      }
    }
  }
}
