{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" cursor-session-start-context --harness cursor",
        "matcher": "startup|resume|clear",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" cursor-destructive-shell-guard --harness cursor",
        "matcher": "Bash|bash|run_shell_command|shell|terminal",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" cursor-protected-file-guard --harness cursor",
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|Bash|bash|run_shell_command",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" git-commit-push-guard --harness cursor",
        "matcher": "Bash|bash|run_shell_command|shell|terminal",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" image-input-optimizer-guard --harness cursor",
        "matcher": "analyze_image|attach_image|screenshot|upload_image|view_image|Read|read",
        "timeout": 60,
        "failClosed": false
      },
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" research-readonly-write-guard --harness cursor",
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|run_shell_command",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" research-dangerous-shell-guard --harness cursor",
        "matcher": "Bash|bash|run_shell_command",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" cursor-post-tool-verify-context --harness cursor",
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|Bash|bash|run_shell_command",
        "timeout": 5
      },
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" research-evidence-ledger --harness cursor",
        "matcher": "WebSearch|web_search|fetch|fetcher|trafilatura|docling|mcp__.*|mcp_.*",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" cursor-stop-truth-gate --harness cursor",
        "timeout": 5
      },
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" research-stop-verifier --harness cursor",
        "timeout": 30
      }
    ],
    "beforeReadFile": [
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" cursor-before-read-file-guard --harness cursor",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" cursor-before-shell-execution-guard --harness cursor",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" cursor-before-mcp-execution-guard --harness cursor",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" cursor-after-file-edit-context --harness cursor",
        "timeout": 5
      }
    ],
    "subagentStart": [
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" cursor-subagent-start-context --harness cursor",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"$CURSOR_PROJECT_DIR/hooks/run-wagents-hook\" research-prompt-triage-context --harness cursor",
        "timeout": 5
      }
    ]
  }
}
