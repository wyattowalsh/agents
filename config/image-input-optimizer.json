{
  "$schema": "./schemas/image-input-optimizer.schema.json",
  "version": 1,
  "cache_dir": "~/.cache/wagents/image-inputs",
  "default_profile": "general",
  "profiles": {
    "general": {
      "description": "Balanced profile for photos and mixed image inputs.",
      "max_long_edge": 2000,
      "max_pixels": 4000000,
      "max_bytes": 4500000,
      "quality_steps": [90, 85, 80, 75, 70],
      "output_format": "jpeg"
    },
    "screenshot-text": {
      "description": "Preserve extra pixels for UI screenshots, charts, diagrams, code, and OCR-heavy inputs.",
      "max_long_edge": 3000,
      "max_pixels": 8000000,
      "max_bytes": 4500000,
      "quality_steps": [95, 90, 85, 80, 75],
      "output_format": "jpeg"
    },
    "transparent": {
      "description": "Preserve alpha for transparent art, logos, masks, overlays, and UI assets.",
      "max_long_edge": 3000,
      "max_pixels": 8000000,
      "max_bytes": 4500000,
      "quality_steps": [95, 90, 85, 80, 75],
      "output_format": "png"
    },
    "thumbnail": {
      "description": "Compact profile for low-risk preview images.",
      "max_long_edge": 1024,
      "max_pixels": 1048576,
      "max_bytes": 1500000,
      "quality_steps": [85, 80, 75, 70],
      "output_format": "jpeg"
    }
  },
  "profile_detection": {
    "screenshot_text_patterns": [
      "screenshot",
      "screen",
      "ui",
      "ocr",
      "receipt",
      "chart",
      "diagram",
      "code",
      "terminal",
      "document",
      "scan"
    ],
    "transparent_requires_alpha": true
  },
  "harnesses": [
    {
      "id": "opencode",
      "tier": "native-transform",
      "enforcement": "native-transform",
      "owner": "opencode-large-image-optimizer@latest",
      "assurance": "OpenCode consumes the repo-managed native plugin and config/opencode-large-image-optimizer.json.",
      "repo_surfaces": ["opencode.json", "config/opencode-large-image-optimizer.json"]
    },
    {
      "id": "codex",
      "tier": "hook-block",
      "enforcement": "pretool-mcp-image-paths-only",
      "owner": "image-input-optimizer-guard",
      "assurance": "Codex PreToolUse only reaches eligible tool inputs; oversized image paths are blocked with optimized retry paths, and native image attachments are not claimed.",
      "repo_surfaces": ["config/hook-registry.json", "hooks/wagents-hook.py", ".codex/hooks.json"]
    },
    {
      "id": "claude-code",
      "tier": "hook-rewrite",
      "enforcement": "pretool-rewrite",
      "owner": "image-input-optimizer-guard",
      "assurance": "PreToolUse hook rewrites eligible image path inputs to cache-optimized derivatives when updatedInput is honored.",
      "repo_surfaces": ["config/hook-registry.json", "hooks/wagents-hook.py", ".claude/settings.json"]
    },
    {
      "id": "cursor",
      "tier": "hook-block",
      "enforcement": "pretool-block-with-optimized-retry",
      "owner": "image-input-optimizer-guard",
      "assurance": "PreToolUse hook blocks oversized image consumption and returns the optimized cache path for retry.",
      "repo_surfaces": ["config/hook-registry.json", "hooks/wagents-hook.py", ".cursor/hooks.json"]
    },
    {
      "id": "gemini-cli",
      "tier": "hook-block",
      "enforcement": "pretool-block-with-optimized-retry",
      "owner": "image-input-optimizer-guard",
      "assurance": "BeforeTool hook blocks oversized image consumption and returns the optimized cache path for retry.",
      "repo_surfaces": ["config/hook-registry.json", "hooks/wagents-hook.py", ".gemini/settings.json"]
    },
    {
      "id": "github-copilot-cli",
      "tier": "hook-block",
      "enforcement": "pretool-block-with-optimized-retry",
      "owner": "image-input-optimizer-guard",
      "assurance": "Command hook blocks oversized image consumption and returns the optimized cache path for retry.",
      "repo_surfaces": ["config/hook-registry.json", "hooks/wagents-hook.py", ".github/hooks/policy.json"]
    },
    {
      "id": "grok-build",
      "tier": "specified-only",
      "enforcement": "not-enabled-until-generic-hook-projection-is-proven",
      "owner": "config/grok-plannotator-hooks.json remains the only generated Grok hook surface",
      "assurance": "No hard assurance is claimed until Grok generic PreToolUse projection is implemented and fixture-tested.",
      "repo_surfaces": ["wagents/platforms/grok.py", "config/grok-plannotator-hooks.json"]
    },
    {
      "id": "chatgpt",
      "tier": "instruction-only",
      "enforcement": "no-local-pre-consumption-hook",
      "owner": "instructions",
      "assurance": "Instruction-only guidance; no hard local hook can assure pre-consumption resizing.",
      "repo_surfaces": ["instructions/global.md"]
    },
    {
      "id": "claude-desktop",
      "tier": "instruction-only",
      "enforcement": "no-local-pre-consumption-hook",
      "owner": "instructions",
      "assurance": "Instruction-only guidance; no hard local hook can assure pre-consumption resizing.",
      "repo_surfaces": ["instructions/global.md"]
    },
    {
      "id": "github-copilot-web",
      "tier": "instruction-only",
      "enforcement": "no-local-pre-consumption-hook",
      "owner": "instructions",
      "assurance": "Instruction-only guidance; web and coding-agent surfaces may be outside local hook control.",
      "repo_surfaces": ["instructions/global.md"]
    },
    {
      "id": "cursor-cloud-subagent",
      "tier": "instruction-only",
      "enforcement": "no-proven-local-pre-consumption-hook",
      "owner": "instructions",
      "assurance": "Instruction-only guidance until cloud subagent hook semantics are proven.",
      "repo_surfaces": ["config/hook-surface-registry.json", "instructions/global.md"]
    },
    {
      "id": "antigravity",
      "tier": "instruction-only",
      "enforcement": "no-proven-local-pre-consumption-hook",
      "owner": "instructions",
      "assurance": "Instruction-only guidance; local pre-consumption image rewrite is not claimed.",
      "repo_surfaces": ["instructions/global.md"]
    },
    {
      "id": "cherry-studio",
      "tier": "instruction-only",
      "enforcement": "mcp-only-no-pre-consumption-hook",
      "owner": "instructions",
      "assurance": "Instruction-only guidance; MCP-only surface has no repo-managed pre-consumption image hook.",
      "repo_surfaces": ["config/mcp-registry.json", "instructions/global.md"]
    },
    {
      "id": "crush",
      "tier": "instruction-only",
      "enforcement": "no-proven-local-pre-consumption-hook",
      "owner": "instructions",
      "assurance": "Instruction-only guidance; local pre-consumption image rewrite is not claimed.",
      "repo_surfaces": ["instructions/global.md"]
    }
  ]
}
