{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenCodeAgents",
  "type": "object",
  "required": ["version", "agents"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mode", "temperature", "color", "permission"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "mode": {
            "const": "subagent"
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "color": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "accent",
              "success",
              "warning",
              "error",
              "info"
            ]
          },
          "permission": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["ask", "allow", "deny"]
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "enum": ["ask", "allow", "deny"]
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}