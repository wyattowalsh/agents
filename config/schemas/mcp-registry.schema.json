{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpRegistry",
  "$defs": {
    "mcpProfileGroupIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      },
      "uniqueItems": true
    },
    "mcpLocalProfileState": {
      "type": "object",
      "required": [
        "groups",
        "endpoint_source"
      ],
      "properties": {
        "groups": {
          "$ref": "#/$defs/mcpProfileGroupIds"
        },
        "endpoint_source": {
          "const": "local"
        }
      },
      "additionalProperties": false
    },
    "mcpApprovalProfileState": {
      "type": "object",
      "required": [
        "groups",
        "endpoint_source",
        "reason",
        "risk_class",
        "approval_scope"
      ],
      "properties": {
        "groups": {
          "$ref": "#/$defs/mcpProfileGroupIds"
        },
        "endpoint_source": {
          "const": "local"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "risk_class": {
          "type": "string",
          "minLength": 1
        },
        "approval_scope": {
          "const": "profile-activation"
        }
      },
      "additionalProperties": false
    },
    "mcpRemoteProfileState": {
      "type": "object",
      "required": [
        "groups",
        "endpoint_source",
        "reason"
      ],
      "properties": {
        "groups": {
          "$ref": "#/$defs/mcpProfileGroupIds"
        },
        "endpoint_source": {
          "const": "public"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "mcpUnsupportedProfileState": {
      "type": "object",
      "required": [
        "groups",
        "reason"
      ],
      "properties": {
        "groups": {
          "$ref": "#/$defs/mcpProfileGroupIds"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "version",
    "instruction_source",
    "servers"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "instruction_source": {
      "type": "string",
      "minLength": 1
    },
    "servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "transport",
          "env",
          "enabled",
          "startup_timeout_sec",
          "timeout_ms",
          "tools",
          "tool_approvals",
          "platform_overrides"
        ],
        "properties": {
          "transport": {
            "type": "string",
            "enum": [
              "stdio",
              "sse",
              "streamable-http",
              "openapi"
            ]
          },
          "auth_policy": {
            "type": "string",
            "enum": [
              "oauth",
              "public-http",
              "account-token",
              "api-key",
              "none"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "passthroughHeaders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "enableKeepAlive": {
            "type": "boolean"
          },
          "keepAliveInterval": {
            "type": "integer",
            "minimum": 1
          },
          "openapi": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "schema": {
                "type": "object"
              }
            },
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "schema"
                ]
              }
            ],
            "additionalProperties": true
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "object"
          },
          "proxy": {
            "type": "object"
          },
          "oauth": {
            "type": "object"
          },
          "env": {
            "type": "object"
          },
          "enabled": {
            "type": "boolean"
          },
          "startup_timeout_sec": {
            "type": "integer",
            "minimum": 1
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tool_approvals": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "never",
                "per-call"
              ]
            }
          },
          "platform_overrides": {
            "type": "object"
          },
          "tools_allow_all": {
            "type": "boolean"
          },
          "group_only": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "transport": {
                  "const": "stdio"
                }
              },
              "required": [
                "transport"
              ]
            },
            "then": {
              "required": [
                "command"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "transport": {
                  "enum": [
                    "streamable-http",
                    "sse"
                  ]
                }
              },
              "required": [
                "transport"
              ]
            },
            "then": {
              "required": [
                "url"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "transport": {
                  "const": "openapi"
                }
              },
              "required": [
                "transport"
              ]
            },
            "then": {
              "required": [
                "openapi"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "mcphub": {
      "type": "object",
      "required": [
        "enabled",
        "base_url",
        "bearer_token_env_var",
        "groups",
        "profile_policy",
        "retired_projections",
        "things_contract"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "public_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "bearer_token_env_var": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "startup_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "tool_timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "settings_path": {
          "type": "string",
          "minLength": 1
        },
        "openapi_export_path": {
          "type": "string",
          "minLength": 1
        },
        "smart_routing": {
          "type": "object",
          "properties": {
            "enabled_env_var": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            },
            "default_enabled": {
              "type": "boolean"
            },
            "base_path": {
              "type": "string",
              "pattern": "^/"
            },
            "database_url_env_var": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            },
            "embedding_provider_env_var": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            },
            "embedding_model_env_var": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            }
          },
          "additionalProperties": true
        },
        "things_contract": {
          "type": "object",
          "required": [
            "version",
            "manifest_path",
            "manifest_schema_path",
            "group",
            "group_id",
            "local_resource",
            "remote_loopback_resource",
            "public_resource",
            "normalized_catalog_sha256",
            "counts",
            "approval_policy"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "manifest_path": {
              "const": "openspec/changes/replace-supathings-with-things-plus-plus/capability-manifest.json"
            },
            "manifest_schema_path": {
              "const": "openspec/changes/replace-supathings-with-things-plus-plus/capability-manifest.schema.json"
            },
            "group": {
              "const": "things"
            },
            "group_id": {
              "const": "3b94a096-b95f-586c-b2e7-e69ed177eb5a"
            },
            "local_resource": {
              "const": "http://127.0.0.1:46683/mcp/things"
            },
            "remote_loopback_resource": {
              "const": "http://127.0.0.1:46684/mcp/things"
            },
            "public_resource": {
              "const": "https://mcp.w4w.dev/mcp/things"
            },
            "normalized_catalog_sha256": {
              "const": "0c48616453e929a8f9d287bb7a4bb59f0d587df3e7008506bfdd7c52472b066e"
            },
            "counts": {
              "type": "object",
              "required": [
                "tools",
                "coreTools",
                "shortcutTools",
                "nativeTools",
                "supaOutcomes",
                "workflows",
                "legacyEvalIds",
                "newEvalIds"
              ],
              "properties": {
                "tools": {
                  "const": 70
                },
                "coreTools": {
                  "const": 41
                },
                "shortcutTools": {
                  "const": 21
                },
                "nativeTools": {
                  "const": 8
                },
                "supaOutcomes": {
                  "const": 37
                },
                "workflows": {
                  "const": 17
                },
                "legacyEvalIds": {
                  "const": 25
                },
                "newEvalIds": {
                  "const": 16
                }
              },
              "additionalProperties": false
            },
            "approval_policy": {
              "type": "object",
              "required": [
                "default",
                "read_only_risk",
                "otherwise"
              ],
              "properties": {
                "default": {
                  "const": "per-call"
                },
                "read_only_risk": {
                  "const": "never"
                },
                "otherwise": {
                  "const": "per-call"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "retired_projections": {
          "type": "object",
          "required": [
            "version",
            "entries"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "entries": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "scope",
                  "targets"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "enum": [
                      "repo",
                      "home",
                      "repo-and-home"
                    ]
                  },
                  "targets": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "profile_policy": {
          "type": "object",
          "required": [
            "version",
            "profiles",
            "targets"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "profiles": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "artifact_kind",
                  "transport",
                  "states"
                ],
                "properties": {
                  "artifact_kind": {
                    "enum": [
                      "portable",
                      "native",
                      "registered-app"
                    ]
                  },
                  "transport": {
                    "const": "streamable-http"
                  },
                  "states": {
                    "type": "object",
                    "required": [
                      "default",
                      "opt-in",
                      "approval-required",
                      "remote-only",
                      "unsupported"
                    ],
                    "properties": {
                      "default": {
                        "$ref": "#/$defs/mcpLocalProfileState"
                      },
                      "opt-in": {
                        "$ref": "#/$defs/mcpLocalProfileState"
                      },
                      "approval-required": {
                        "$ref": "#/$defs/mcpApprovalProfileState"
                      },
                      "remote-only": {
                        "$ref": "#/$defs/mcpRemoteProfileState"
                      },
                      "unsupported": {
                        "$ref": "#/$defs/mcpUnsupportedProfileState"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "targets": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "profile"
                ],
                "properties": {
                  "profile": {
                    "type": "string",
                    "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "enabled",
              "servers"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "enabled": {
                "type": "boolean"
              },
              "tools_allow_all": {
                "type": "boolean"
              },
              "servers": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "required": [
                        "name"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "alias": {
                          "type": "string",
                          "minLength": 1
                        },
                        "tools": {
                          "oneOf": [
                            {
                              "const": "all"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "minItems": 1,
                              "uniqueItems": true
                            }
                          ]
                        },
                        "prompts": {
                          "oneOf": [
                            {
                              "const": "all"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "minItems": 1,
                              "uniqueItems": true
                            }
                          ]
                        },
                        "resources": {
                          "oneOf": [
                            {
                              "const": "all"
                            },
                            {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "minItems": 1,
                              "uniqueItems": true
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "clients": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string"
              },
              "auth": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "url_source": {
                "enum": [
                  "local",
                  "public"
                ]
              },
              "clients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "included_endpoint_kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "all",
                    "group",
                    "server",
                    "smart"
                  ]
                },
                "uniqueItems": true
              },
              "enabled_endpoint_kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "all",
                    "group",
                    "server",
                    "smart"
                  ]
                },
                "uniqueItems": true
              },
              "enabled_groups": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "included_groups": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "included_servers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "enable_server_endpoints": {
                "type": "boolean"
              },
              "server_endpoint_name_style": {
                "enum": [
                  "prefixed",
                  "base"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "contributor_defaults": {
      "type": "object",
      "required": [
        "tools_policy",
        "wildcard_requires_explicit_opt_in"
      ],
      "properties": {
        "tools_policy": {
          "const": "deny-by-default"
        },
        "wildcard_requires_explicit_opt_in": {
          "type": "boolean"
        },
        "new_server_tools_default": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
