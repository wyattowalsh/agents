{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents.w4w.dev/schemas/runtime-rollback-commit-marker.schema.json",
  "title": "Candidate runtime rollback commit marker",
  "type": "object",
  "required": [
    "version",
    "transaction_id",
    "status",
    "journal_path",
    "journal_sha256",
    "artifact_ids",
    "receipt_revision",
    "receipt_store_transaction_id",
    "receipt_document_sha256"
  ],
  "properties": {
    "version": {"const": 2},
    "transaction_id": {"type": "string", "minLength": 1},
    "status": {"const": "passed"},
    "journal_path": {"type": "string", "minLength": 1},
    "journal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "receipt_revision": {"type": "integer", "minimum": 1},
    "receipt_store_transaction_id": {"type": "string", "minLength": 1},
    "receipt_document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
