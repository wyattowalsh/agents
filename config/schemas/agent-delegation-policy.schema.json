{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentDelegationPolicy",
  "type": "object",
  "required": ["version", "delegators"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "delegators": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["task_default", "allow"],
        "properties": {
          "task_default": {
            "const": "deny"
          },
          "deny_self": {
            "type": "boolean"
          },
          "allow": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}