{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillsCatalogBrowserIndex",
  "type": "object",
  "required": ["externalSkillIndex"],
  "properties": {
    "externalSkillIndex": {
      "type": "array",
      "items": { "$ref": "#/$defs/browserSkillRow" }
    },
    "tagFacetIndex": {
      "type": "array",
      "items": { "type": "string" }
    },
    "platformFacetIndex": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "browserSkillRow": {
      "type": "object",
      "required": [
        "name",
        "description",
        "href",
        "lane",
        "sourceType",
        "tagFacetIds",
        "platformFacetIds"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "href": {
          "type": "string",
          "pattern": "^/skills/catalog/external/[^/]+/$"
        },
        "lane": {
          "enum": ["install-now", "inspect", "avoid", "integrated", "hard-blocked"]
        },
        "sourceType": { "type": "string" },
        "tagFacetIds": { "type": "string" },
        "platformFacetIds": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
