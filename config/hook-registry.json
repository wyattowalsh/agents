{
  "$schema": "./schemas/hook-registry.schema.json",
  "version": 1,
  "hooks": [
    {
      "id": "session-start",
      "description": "Report basic session environment and repository state.",
      "logical_policy": "session-start",
      "logical_event": "SessionStart",
      "matcher": "startup|resume|clear",
      "command": "./hooks/session-start.sh",
      "timeout": 15,
      "harnesses": [
        "github-copilot"
      ]
    },
    {
      "id": "prompt-log",
      "description": "Write local prompt audit entries with short retention.",
      "logical_policy": "prompt-log",
      "logical_event": "UserPromptSubmit",
      "command": "./hooks/log-prompt.sh",
      "timeout": 5,
      "harnesses": [
        "github-copilot"
      ]
    },
    {
      "id": "destructive-shell-guard",
      "description": "Block high-risk shell commands.",
      "logical_policy": "destructive-shell-guard",
      "logical_event": "PreToolUse",
      "matcher": "Bash|bash|run_shell_command",
      "command": "./hooks/guard-destructive.sh",
      "timeout": 5,
      "harnesses": [
        "github-copilot"
      ]
    },
    {
      "id": "protected-file-guard",
      "description": "Block edits to protected paths and secret-bearing files.",
      "logical_policy": "protected-file-guard",
      "logical_event": "PreToolUse",
      "matcher": "Edit|Write|MultiEdit|edit|create|write_file|replace",
      "command": "./hooks/protect-files.sh",
      "timeout": 5,
      "harnesses": [
        "github-copilot"
      ]
    },
    {
      "id": "post-edit-format",
      "description": "Run best-effort formatter after edits.",
      "logical_policy": "post-edit-format",
      "logical_event": "PostToolUse",
      "matcher": "Edit|Write|MultiEdit|edit|create|write_file|replace",
      "command": "./hooks/auto-format.sh",
      "timeout": 60,
      "bundle_group": "copilot-post-edit-quality",
      "bundle_mode": "context-chain",
      "harnesses": [
        "github-copilot"
      ]
    },
    {
      "id": "post-edit-lint",
      "description": "Return concise lint/type context after edits.",
      "logical_policy": "post-edit-lint",
      "logical_event": "PostToolUse",
      "matcher": "Edit|Write|MultiEdit|edit|create|write_file|replace",
      "command": "./hooks/lint-check.sh",
      "timeout": 30,
      "bundle_group": "copilot-post-edit-quality",
      "bundle_mode": "context-chain",
      "harnesses": [
        "github-copilot"
      ]
    },
    {
      "id": "codex-session-start-context",
      "description": "Report lightweight Codex session and repository context.",
      "status_message": "Gathering Codex session context",
      "mode": "context",
      "logical_policy": "codex-session-start-context",
      "logical_event": "SessionStart",
      "matcher": "startup|resume|clear",
      "command": "{hook_runner} codex-session-start-context --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "codex"
      ]
    },
    {
      "id": "codex-destructive-shell-guard",
      "description": "Block critical destructive shell commands in Codex.",
      "status_message": "Checking shell safety",
      "mode": "enforce",
      "logical_policy": "codex-destructive-shell-guard",
      "logical_event": "PreToolUse",
      "matcher": "Bash|bash|run_shell_command|shell|terminal",
      "command": "{hook_runner} codex-destructive-shell-guard --harness {harness}",
      "timeout": 5,
      "bundle_group": "codex-shell-file-guards",
      "bundle_mode": "enforce-chain",
      "harnesses": [
        "codex"
      ]
    },
    {
      "id": "codex-protected-file-guard",
      "description": "Block protected files, secret-bearing paths, git internals, traversal, and direct lockfile edits in Codex.",
      "status_message": "Checking protected paths",
      "mode": "enforce",
      "logical_policy": "codex-protected-file-guard",
      "logical_event": "PreToolUse",
      "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|Bash|bash|run_shell_command",
      "command": "{hook_runner} codex-protected-file-guard --harness {harness}",
      "timeout": 5,
      "bundle_group": "codex-shell-file-guards",
      "bundle_mode": "enforce-chain",
      "harnesses": [
        "codex"
      ]
    },
    {
      "id": "codex-permission-request-guard",
      "description": "Deny high-risk Codex permission requests and otherwise preserve the normal approval flow.",
      "status_message": "Checking approval request safety",
      "mode": "enforce",
      "logical_policy": "codex-permission-request-guard",
      "logical_event": "PermissionRequest",
      "command": "{hook_runner} codex-permission-request-guard --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "codex"
      ]
    },
    {
      "id": "codex-post-tool-verify-context",
      "description": "Run lightweight context-only post-edit quality checks and return verification guidance after Codex tool use.",
      "status_message": "Checking post-edit quality",
      "mode": "context",
      "logical_policy": "codex-post-tool-verify-context",
      "logical_event": "PostToolUse",
      "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|Bash|bash|run_shell_command",
      "command": "{hook_runner} codex-post-tool-verify-context --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "codex"
      ]
    },
    {
      "id": "codex-stop-truth-gate",
      "description": "Ask Codex for one more pass when final code-change claims omit validation evidence.",
      "status_message": "Checking final-answer evidence",
      "mode": "enforce",
      "logical_policy": "codex-stop-truth-gate",
      "logical_event": "Stop",
      "command": "{hook_runner} codex-stop-truth-gate --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "codex"
      ]
    },
    {
      "id": "cursor-session-start-context",
      "description": "Report lightweight Cursor session and repository context.",
      "status_message": "Gathering Cursor session context",
      "mode": "context",
      "logical_policy": "cursor-session-start-context",
      "logical_event": "SessionStart",
      "matcher": "startup|resume|clear",
      "command": "{hook_runner} cursor-session-start-context --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "cursor-destructive-shell-guard",
      "description": "Block critical destructive shell commands in Cursor.",
      "status_message": "Checking shell safety",
      "mode": "enforce",
      "logical_policy": "cursor-destructive-shell-guard",
      "logical_event": "PreToolUse",
      "matcher": "Bash|bash|run_shell_command|shell|terminal",
      "command": "{hook_runner} cursor-destructive-shell-guard --harness {harness}",
      "timeout": 5,
      "bundle_group": "cursor-shell-file-guards",
      "bundle_mode": "enforce-chain",
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "cursor-protected-file-guard",
      "description": "Block protected files, secret-bearing paths, git internals, traversal, and direct lockfile edits in Cursor.",
      "status_message": "Checking protected paths",
      "mode": "enforce",
      "logical_policy": "cursor-protected-file-guard",
      "logical_event": "PreToolUse",
      "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|Bash|bash|run_shell_command",
      "command": "{hook_runner} cursor-protected-file-guard --harness {harness}",
      "timeout": 5,
      "bundle_group": "cursor-shell-file-guards",
      "bundle_mode": "enforce-chain",
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "cursor-post-tool-verify-context",
      "description": "Run lightweight context-only post-edit quality checks and return verification guidance after Cursor tool use.",
      "status_message": "Checking post-edit quality",
      "mode": "context",
      "logical_policy": "cursor-post-tool-verify-context",
      "logical_event": "PostToolUse",
      "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|Bash|bash|run_shell_command",
      "command": "{hook_runner} cursor-post-tool-verify-context --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "cursor-stop-truth-gate",
      "description": "Ask Cursor for one more pass when final code-change claims omit validation evidence.",
      "status_message": "Checking final-answer evidence",
      "mode": "enforce",
      "logical_policy": "cursor-stop-truth-gate",
      "logical_event": "Stop",
      "command": "{hook_runner} cursor-stop-truth-gate --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "cursor-before-read-file-guard",
      "description": "Block reads of secret-bearing files (.env, keys, credential stores) before they enter Cursor context.",
      "status_message": "Checking file-read safety",
      "mode": "enforce",
      "logical_policy": "cursor-before-read-file-guard",
      "logical_event": "BeforeReadFile",
      "command": "{hook_runner} cursor-before-read-file-guard --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "cursor-before-shell-execution-guard",
      "description": "Block destructive shell commands and unsafe git history rewrites on Cursor's beforeShellExecution event.",
      "status_message": "Checking shell-execution safety",
      "mode": "enforce",
      "logical_policy": "cursor-before-shell-execution-guard",
      "logical_event": "BeforeShellExecution",
      "command": "{hook_runner} cursor-before-shell-execution-guard --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "cursor-before-mcp-execution-guard",
      "description": "Block destructive MCP tool calls (shell passthroughs, out-of-workspace deletes) before execution in Cursor.",
      "status_message": "Checking MCP-execution safety",
      "mode": "enforce",
      "logical_policy": "cursor-before-mcp-execution-guard",
      "logical_event": "BeforeMCPExecution",
      "command": "{hook_runner} cursor-before-mcp-execution-guard --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "cursor-after-file-edit-context",
      "description": "Return lightweight post-edit quality context after Cursor file edits.",
      "status_message": "Checking post-edit quality",
      "mode": "context",
      "logical_policy": "cursor-after-file-edit-context",
      "logical_event": "AfterFileEdit",
      "command": "{hook_runner} cursor-after-file-edit-context --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "cursor-subagent-start-context",
      "description": "Inject repository conventions and session context when a Cursor subagent starts.",
      "status_message": "Gathering subagent context",
      "mode": "context",
      "logical_policy": "cursor-subagent-start-context",
      "logical_event": "SubagentStart",
      "command": "{hook_runner} cursor-subagent-start-context --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "cursor"
      ]
    },
    {
      "id": "git-commit-push-guard",
      "description": "Block force-pushes to protected branches, hook-skipping commits, and unsafe history rewrites across the fleet.",
      "status_message": "Checking git commit/push safety",
      "mode": "enforce",
      "logical_policy": "git-commit-push-guard",
      "logical_event": "PreToolUse",
      "matcher": "Bash|bash|run_shell_command|shell|terminal",
      "command": "{hook_runner} git-commit-push-guard --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "codex",
        "claude-code",
        "cursor",
        "github-copilot",
        "gemini-cli"
      ]
    },
    {
      "id": "image-input-optimizer-guard",
      "description": "Resize and compress oversized local image inputs before harnesses consume them.",
      "status_message": "Optimizing image inputs",
      "mode": "enforce",
      "degraded_behavior": "block with an optimized retry path when the harness cannot safely accept updated input",
      "logical_policy": "image-input-optimizer-guard",
      "logical_event": "PreToolUse",
      "matcher": "analyze_image|attach_image|screenshot|upload_image|view_image|Read|read|.*[Ii]mage.*|.*[Vv]ision.*|.*[Ss]creenshot.*|.*[Aa]ttach.*|.*[Uu]pload.*",
      "command": "{hook_runner} image-input-optimizer-guard --harness {harness}",
      "timeout": 60,
      "harnesses": [
        "codex",
        "claude-code",
        "cursor",
        "github-copilot",
        "gemini-cli"
      ]
    },
    {
      "id": "research-prompt-triage-context",
      "description": "Activate research hook state and inject research-method reminders.",
      "mode": "context",
      "logical_policy": "research-prompt-triage-context",
      "logical_event": "UserPromptSubmit",
      "command": "{hook_runner} research-prompt-triage-context --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "codex",
        "claude-code",
        "cursor",
        "github-copilot",
        "gemini-cli"
      ]
    },
    {
      "id": "research-readonly-write-guard",
      "description": "Prevent source-file write tools during active research sessions.",
      "mode": "enforce",
      "degraded_behavior": "audit when the harness payload does not expose a tool name or writable path",
      "logical_policy": "research-readonly-write-guard",
      "logical_event": "PreToolUse",
      "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|run_shell_command",
      "command": "{hook_runner} research-readonly-write-guard --harness {harness}",
      "timeout": 5,
      "bundle_group": "research-shell-guards",
      "bundle_mode": "enforce-chain",
      "harnesses": [
        "codex",
        "claude-code",
        "cursor",
        "github-copilot",
        "gemini-cli"
      ]
    },
    {
      "id": "research-dangerous-shell-guard",
      "description": "Block dangerous shell side effects during active research sessions.",
      "mode": "enforce",
      "degraded_behavior": "audit when the harness payload does not expose a shell command",
      "logical_policy": "research-dangerous-shell-guard",
      "logical_event": "PreToolUse",
      "matcher": "Bash|bash|run_shell_command",
      "command": "{hook_runner} research-dangerous-shell-guard --harness {harness}",
      "timeout": 5,
      "bundle_group": "research-shell-guards",
      "bundle_mode": "enforce-chain",
      "harnesses": [
        "codex",
        "claude-code",
        "cursor",
        "github-copilot",
        "gemini-cli"
      ]
    },
    {
      "id": "research-evidence-ledger",
      "description": "Append lightweight provenance metadata for research retrieval tools.",
      "mode": "audit",
      "logical_policy": "research-evidence-ledger",
      "logical_event": "PostToolUse",
      "matcher": "WebSearch|web_search|fetch|fetcher|trafilatura|docling|mcp__.*|mcp_.*",
      "command": "{hook_runner} research-evidence-ledger --harness {harness}",
      "timeout": 5,
      "harnesses": [
        "codex",
        "claude-code",
        "cursor",
        "github-copilot",
        "gemini-cli"
      ]
    },
    {
      "id": "research-stop-verifier",
      "description": "Verify research skill invariants before an active research session completes.",
      "mode": "enforce",
      "logical_policy": "research-stop-verifier",
      "logical_event": "Stop",
      "command": "{hook_runner} research-stop-verifier --harness {harness}",
      "timeout": 30,
      "harnesses": [
        "codex",
        "claude-code",
        "cursor",
        "gemini-cli",
        "github-copilot"
      ]
    },
    {
      "id": "verify-before-stop",
      "description": "Block stopping when modified files carry debug artifacts or fail fast lint/type checks.",
      "mode": "enforce",
      "logical_policy": "verify-before-stop",
      "logical_event": "Stop",
      "command": "{repo_root}/hooks/verify-before-stop.sh",
      "timeout": 60,
      "harnesses": [
        "claude-code"
      ]
    },
    {
      "id": "task-completed-gate",
      "description": "Block task completion when modified files have syntax errors, incomplete markers, or failing tests.",
      "mode": "enforce",
      "logical_policy": "task-completed-gate",
      "logical_event": "Stop",
      "command": "{repo_root}/hooks/task-completed-gate.sh",
      "timeout": 120,
      "harnesses": [
        "claude-code"
      ]
    },
    {
      "id": "teammate-idle-gate",
      "description": "Block a subagent from going idle with broken syntax, critical lint, type, or test failures.",
      "mode": "enforce",
      "logical_policy": "teammate-idle-gate",
      "logical_event": "SubagentStop",
      "command": "{repo_root}/hooks/teammate-idle-gate.sh",
      "timeout": 120,
      "harnesses": [
        "claude-code"
      ]
    }
  ]
}
