{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "SwitchMode",
        "command": "__PLANNOTATOR_CURSOR_PLAN_HOOK__ enter",
        "timeout": 5,
        "failClosed": false
      },
      {
        "matcher": "CreatePlan",
        "command": "__PLANNOTATOR_CURSOR_PLAN_HOOK__ exit",
        "timeout": 345600,
        "failClosed": false
      }
    ]
  }
}
