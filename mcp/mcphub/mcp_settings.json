{
  "mcpServers": {
    "agent-catalog": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/agent-catalog",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    },
    "arxiv": {
      "command": "bash",
      "args": [
        "-lc",
        "uvx --offline arxiv-mcp-server || uvx arxiv-mcp-server"
      ],
      "timeout": 600000
    },
    "atom-of-thoughts": {
      "command": "node",
      "args": [
        "${REPO_ROOT}/mcp/servers/MCP_Atom_of_Thoughts/build/index.js"
      ],
      "timeout": 600000
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "timeout": 600000
    },
    "cascade-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "cascade-thinking-mcp"
      ],
      "timeout": 600000
    },
    "chrome-devtools": {
      "command": "bash",
      "args": [
        "${REPO_ROOT}/scripts/mcphub/chrome-devtools-browser-url.sh"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      },
      "timeout": 600000
    },
    "ci-artifacts": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/ci-artifacts",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    },
    "context7": {
      "type": "streamable-http",
      "url": "https://mcp.context7.com/mcp/oauth",
      "timeout": 600000
    },
    "crash": {
      "command": "npx",
      "args": [
        "-y",
        "crash-mcp"
      ],
      "env": {
        "CRASH_STRICT_MODE": "${CRASH_STRICT_MODE}",
        "MAX_HISTORY_SIZE": "${MAX_HISTORY_SIZE}"
      },
      "timeout": 600000
    },
    "creative-thinking": {
      "command": "${REPO_ROOT}/scripts/mcp_tools/run_mcp_thinking.sh",
      "args": [],
      "timeout": 600000
    },
    "deep-lucid-3d": {
      "command": "npx",
      "args": [
        "-y",
        "github:mushroomfleet/deeplucid3d-mcp"
      ],
      "timeout": 600000
    },
    "deepwiki": {
      "type": "streamable-http",
      "url": "https://mcp.deepwiki.com/mcp",
      "timeout": 600000
    },
    "docling": {
      "command": "${REPO_ROOT}/scripts/mcphub/docling-stdio.sh",
      "args": [],
      "timeout": 600000
    },
    "docs-graph": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/docs-graph",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    },
    "docs-index": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/docs-index",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    },
    "duckduckgo-search": {
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ],
      "timeout": 600000
    },
    "eval-results": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/eval-results",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    },
    "exa": {
      "type": "streamable-http",
      "url": "https://mcp.exa.ai/mcp",
      "timeout": 600000
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-fetch-server"
      ],
      "timeout": 600000
    },
    "fetcher": {
      "command": "npx",
      "args": [
        "-y",
        "fetcher-mcp"
      ],
      "timeout": 600000
    },
    "g-search": {
      "command": "npx",
      "args": [
        "-y",
        "g-search-mcp"
      ],
      "timeout": 600000
    },
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ],
      "timeout": 600000
    },
    "linkedin": {
      "command": "uvx",
      "args": [
        "linkedin-scraper-mcp",
        "--no-headless"
      ],
      "timeout": 600000
    },
    "lotus-wisdom-mcp": {
      "command": "node",
      "args": [
        "${REPO_ROOT}/mcp/servers/lotus-wisdom-mcp/dist/bundle.js"
      ],
      "timeout": 600000
    },
    "ossinsight": {
      "command": "npx",
      "args": [
        "-y",
        "ossinsight-mcp"
      ],
      "timeout": 600000
    },
    "package-version-check-mcp": {
      "command": "bash",
      "args": [
        "${REPO_ROOT}/scripts/mcphub/package-version-check-mcp.sh"
      ],
      "env": {
        "GITHUB_PAT": "${GITHUB_PAT}"
      },
      "timeout": 600000
    },
    "penpot": {
      "type": "streamable-http",
      "url": "https://design.penpot.app/mcp/stream?userToken=${PENPOT_MCP_USER_TOKEN}",
      "env": {
        "PENPOT_MCP_USER_TOKEN": "${PENPOT_MCP_USER_TOKEN}"
      },
      "timeout": 600000
    },
    "release-provenance": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/release-provenance",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    },
    "repo-readonly": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/repo-readonly",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    },
    "repomix": {
      "command": "npx",
      "args": [
        "-y",
        "repomix",
        "--mcp"
      ],
      "timeout": 600000
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "timeout": 600000
    },
    "shannon-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "server-shannon-thinking@latest"
      ],
      "timeout": 600000
    },
    "skill-catalog": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/skill-catalog",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    },
    "source-url-health": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/source-url-health",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    },
    "structured-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "structured-thinking"
      ],
      "timeout": 600000
    },
    "supathings": {
      "command": "npx",
      "args": [
        "-y",
        "supathings-mcp"
      ],
      "timeout": 600000
    },
    "tavily": {
      "type": "streamable-http",
      "url": "https://mcp.tavily.com/mcp/",
      "timeout": 600000
    },
    "template-smoke": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/template-smoke",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    },
    "think-strategies": {
      "command": "npx",
      "args": [
        "-y",
        "github:aaronsb/think-strategies"
      ],
      "timeout": 600000
    },
    "trafilatura": {
      "command": "uv",
      "args": [
        "--directory",
        "${REPO_ROOT}/mcp/servers/trafilatura_mcp",
        "run",
        "python3",
        "trafilatura_mcp.py"
      ],
      "timeout": 600000
    },
    "wayback": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "mcp-wayback-machine"
      ],
      "timeout": 600000
    },
    "wikipedia": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "wikipedia-mcp"
      ],
      "timeout": 600000
    },
    "workflow-status": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/workflow-status",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000,
      "disabled": true
    }
  },
  "groups": {
    "account-backed": {
      "name": "account-backed",
      "description": "Tools backed by user accounts or personal app state.",
      "servers": [
        "gmail",
        "linkedin",
        "supathings",
        "penpot"
      ]
    },
    "accounts": {
      "name": "accounts",
      "description": "Account-backed connectors.",
      "servers": [
        "gmail",
        "linkedin"
      ]
    },
    "browser": {
      "name": "browser",
      "description": "Live browser automation.",
      "servers": [
        "chrome-devtools"
      ]
    },
    "coding": {
      "name": "coding",
      "description": "Coding, dependency lookup, repo inspection, and browser validation workflow.",
      "servers": [
        "context7",
        "deepwiki",
        "fetch",
        "duckduckgo-search",
        "repomix",
        "package-version-check-mcp",
        "ossinsight",
        "chrome-devtools"
      ]
    },
    "credentialed": {
      "name": "credentialed",
      "description": "Tools that rely on provider API keys, OAuth, or user-owned account tokens.",
      "servers": [
        "brave-search",
        "context7",
        "tavily",
        "exa",
        "penpot"
      ]
    },
    "daily": {
      "name": "daily",
      "description": "Broader local workhorse bundle for routine agentic development.",
      "servers": [
        "brave-search",
        "duckduckgo-search",
        "context7",
        "deepwiki",
        "fetch",
        {
          "name": "fetcher",
          "tools": [
            "fetch_urls"
          ]
        },
        "package-version-check-mcp",
        "trafilatura",
        "repomix",
        "chrome-devtools"
      ]
    },
    "design": {
      "name": "design",
      "description": "Design tooling.",
      "servers": [
        "penpot"
      ]
    },
    "docs": {
      "name": "docs",
      "description": "Library, framework, repo docs, and docs graph lookup.",
      "servers": [
        "context7",
        "deepwiki"
      ]
    },
    "experimental": {
      "name": "experimental",
      "description": "Bleeding-edge, less-proven, or high-variance tools.",
      "servers": [
        "exa",
        "g-search",
        "atom-of-thoughts",
        "crash",
        "creative-thinking",
        "deep-lucid-3d",
        "lotus-wisdom-mcp",
        "shannon-thinking",
        "think-strategies"
      ]
    },
    "harness": {
      "name": "harness",
      "description": "Default local harness bundle: highest-value tools with bounded schema/context cost.",
      "servers": [
        "brave-search",
        "duckduckgo-search",
        "context7",
        "deepwiki",
        "fetch",
        {
          "name": "fetcher",
          "tools": [
            "fetch_urls"
          ]
        },
        "package-version-check-mcp",
        "chrome-devtools",
        "penpot"
      ]
    },
    "heavy": {
      "name": "heavy",
      "description": "Large-output or heavier processing tools.",
      "servers": [
        "repomix",
        "docling",
        "deep-lucid-3d"
      ]
    },
    "live-browser": {
      "name": "live-browser",
      "description": "Tools that automate or depend on live browser/session state.",
      "servers": [
        "chrome-devtools",
        "linkedin"
      ]
    },
    "media": {
      "name": "media",
      "description": "Document and 3D processing.",
      "servers": [
        "docling",
        "deep-lucid-3d"
      ]
    },
    "media-work": {
      "name": "media-work",
      "description": "Document, 3D, and web-ingestion workflow; prefer an agent skill plus ffmpeg CLI for deterministic media transforms.",
      "servers": [
        "docling",
        "deep-lucid-3d",
        "fetch",
        "trafilatura"
      ]
    },
    "personal-work": {
      "name": "personal-work",
      "description": "Explicit personal-account and design/productivity workflow.",
      "servers": [
        "gmail",
        "linkedin",
        "supathings",
        "penpot"
      ]
    },
    "productivity": {
      "name": "productivity",
      "description": "Productivity tooling.",
      "servers": [
        "supathings"
      ]
    },
    "reasoning": {
      "name": "reasoning",
      "description": "Curated structured-thinking servers (three proven tools only).",
      "servers": [
        "sequential-thinking",
        "cascade-thinking",
        "structured-thinking"
      ]
    },
    "reasoning-lab": {
      "name": "reasoning-lab",
      "description": "Experimental or less-proven reasoning tools.",
      "servers": [
        "atom-of-thoughts",
        "crash",
        "creative-thinking",
        "lotus-wisdom-mcp",
        "shannon-thinking",
        "think-strategies"
      ]
    },
    "references": {
      "name": "references",
      "description": "Academic papers, encyclopedia, and archive lookup.",
      "servers": [
        "arxiv",
        "wikipedia",
        "wayback"
      ]
    },
    "release": {
      "name": "release",
      "description": "Release, package, CI artifact, provenance, and eval-readiness workflow.",
      "servers": [
        "package-version-check-mcp",
        "repomix",
        "fetch",
        "trafilatura"
      ]
    },
    "repo": {
      "name": "repo",
      "description": "Repository and package intelligence.",
      "servers": [
        "repomix",
        "package-version-check-mcp",
        "ossinsight"
      ]
    },
    "research": {
      "name": "research",
      "description": "Search, retrieval, public references, and source inspection workflow.",
      "servers": [
        "brave-search",
        "duckduckgo-search",
        "tavily",
        "exa",
        "fetch",
        "fetcher",
        "trafilatura",
        "arxiv",
        "wikipedia",
        "wayback",
        "deepwiki",
        "package-version-check-mcp"
      ]
    },
    "review": {
      "name": "review",
      "description": "Code, docs, eval, source-health, workflow-status, and browser-backed review workflow.",
      "servers": [
        "context7",
        "deepwiki",
        "fetch",
        "duckduckgo-search",
        "package-version-check-mcp",
        "repomix",
        "chrome-devtools"
      ]
    },
    "shared-read": {
      "name": "shared-read",
      "description": "Broad read-oriented pool for explicit opt-in without personal or browser tools.",
      "servers": [
        "brave-search",
        "context7",
        "deepwiki",
        "fetch",
        "package-version-check-mcp",
        "duckduckgo-search",
        "trafilatura",
        "arxiv",
        "wikipedia",
        "wayback"
      ]
    },
    "tunnel": {
      "name": "tunnel",
      "description": "Minimal remote ChatGPT tunnel surface without personal, browser, or heavy tools.",
      "servers": [
        "brave-search",
        "context7",
        "deepwiki",
        "fetch",
        "package-version-check-mcp"
      ]
    },
    "web-read": {
      "name": "web-read",
      "description": "URL and page ingestion without search APIs.",
      "servers": [
        "fetch",
        "fetcher",
        "trafilatura",
        "wayback"
      ]
    },
    "web-search": {
      "name": "web-search",
      "description": "Web search providers.",
      "servers": [
        "brave-search",
        "duckduckgo-search",
        "tavily",
        "exa",
        "g-search"
      ]
    }
  },
  "systemConfig": {
    "routing": {
      "enableGlobalRoute": true,
      "enableGroupNameRoute": true,
      "enableBearerAuth": true,
      "bearerAuthHeaderName": "Authorization",
      "jsonBodyLimit": "5mb",
      "skipAuth": false
    },
    "smartRouting": {
      "enabled": false,
      "embeddingProvider": "${SMART_ROUTING_EMBEDDING_PROVIDER}",
      "embeddingModel": "${EMBEDDING_MODEL}",
      "progressiveDisclosure": "${SMART_ROUTING_PROGRESSIVE_DISCLOSURE}"
    },
    "toolResultCompression": {
      "enabled": false,
      "minTokens": 2000,
      "maxOutputTokens": 1200,
      "strategy": "auto"
    }
  }
}
