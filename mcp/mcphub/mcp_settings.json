{
  "mcpServers": {
    "agent-catalog": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/agent-catalog",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    },
    "arxiv": {
      "command": "bash",
      "args": [
        "-lc",
        "uvx --offline arxiv-mcp-server || uvx arxiv-mcp-server"
      ],
      "timeout": 600000
    },
    "atom-of-thoughts": {
      "command": "node",
      "args": [
        "${REPO_ROOT}/mcp/servers/MCP_Atom_of_Thoughts/build/index.js"
      ],
      "timeout": 600000
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "timeout": 600000
    },
    "cascade-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "cascade-thinking-mcp"
      ],
      "timeout": 600000
    },
    "chrome-devtools": {
      "command": "bash",
      "args": [
        "${REPO_ROOT}/scripts/mcphub/chrome-devtools-browser-url.sh"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      },
      "timeout": 600000
    },
    "ci-artifacts": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/ci-artifacts",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "timeout": 600000
    },
    "crash": {
      "command": "npx",
      "args": [
        "-y",
        "crash-mcp"
      ],
      "env": {
        "CRASH_STRICT_MODE": "${CRASH_STRICT_MODE}",
        "MAX_HISTORY_SIZE": "${MAX_HISTORY_SIZE}"
      },
      "timeout": 600000
    },
    "creative-thinking": {
      "command": "${REPO_ROOT}/scripts/mcp_tools/run_mcp_thinking.sh",
      "args": [],
      "timeout": 600000
    },
    "deep-lucid-3d": {
      "command": "npx",
      "args": [
        "-y",
        "github:mushroomfleet/deeplucid3d-mcp"
      ],
      "timeout": 600000
    },
    "deepwiki": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.deepwiki.com/mcp"
      ],
      "timeout": 600000
    },
    "docling": {
      "command": "${REPO_ROOT}/scripts/mcphub/docling-stdio.sh",
      "args": [],
      "timeout": 600000
    },
    "docs-graph": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/docs-graph",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    },
    "docs-index": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/docs-index",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    },
    "duckduckgo-search": {
      "command": "uvx",
      "args": [
        "duckduckgo-mcp-server"
      ],
      "timeout": 600000
    },
    "eval-results": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/eval-results",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      },
      "timeout": 600000
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-fetch-server"
      ],
      "timeout": 600000
    },
    "fetcher": {
      "command": "npx",
      "args": [
        "-y",
        "fetcher-mcp"
      ],
      "timeout": 600000
    },
    "ffmpeg": {
      "command": "uv",
      "args": [
        "--directory",
        "${REPO_ROOT}/mcp/servers/ffmpeg-mcp",
        "run",
        "ffmpeg-mcp"
      ],
      "timeout": 600000
    },
    "g-search": {
      "command": "npx",
      "args": [
        "-y",
        "g-search-mcp"
      ],
      "timeout": 600000
    },
    "gmail": {
      "command": "npx",
      "args": [
        "-y",
        "@gongrzhe/server-gmail-autoauth-mcp"
      ],
      "timeout": 600000
    },
    "linkedin": {
      "command": "uvx",
      "args": [
        "linkedin-scraper-mcp",
        "--no-headless"
      ],
      "timeout": 600000
    },
    "lotus-wisdom-mcp": {
      "command": "node",
      "args": [
        "${REPO_ROOT}/mcp/servers/lotus-wisdom-mcp/dist/bundle.js"
      ],
      "timeout": 600000
    },
    "ossinsight": {
      "command": "npx",
      "args": [
        "-y",
        "ossinsight-mcp"
      ],
      "timeout": 600000
    },
    "package-version": {
      "command": "~/go/bin/mcp-package-version",
      "args": [],
      "timeout": 600000
    },
    "penpot": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://design.penpot.app/mcp/stream?userToken=${PENPOT_MCP_USER_TOKEN}"
      ],
      "env": {
        "PENPOT_MCP_USER_TOKEN": "${PENPOT_MCP_USER_TOKEN}"
      },
      "timeout": 600000
    },
    "release-provenance": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/release-provenance",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    },
    "repo-readonly": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/repo-readonly",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    },
    "repomix": {
      "command": "npx",
      "args": [
        "-y",
        "repomix",
        "--mcp"
      ],
      "timeout": 600000
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "timeout": 600000
    },
    "shannon-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "server-shannon-thinking@latest"
      ],
      "timeout": 600000
    },
    "skill-catalog": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/skill-catalog",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    },
    "source-url-health": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/source-url-health",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    },
    "structured-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "structured-thinking"
      ],
      "timeout": 600000
    },
    "supathings": {
      "command": "npx",
      "args": [
        "-y",
        "supathings-mcp"
      ],
      "timeout": 600000
    },
    "tavily": {
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      },
      "timeout": 600000
    },
    "template-smoke": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/template-smoke",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    },
    "think-strategies": {
      "command": "npx",
      "args": [
        "-y",
        "github:aaronsb/think-strategies"
      ],
      "timeout": 600000
    },
    "trafilatura": {
      "command": "uv",
      "args": [
        "--directory",
        "${REPO_ROOT}/mcp/servers/trafilatura_mcp",
        "run",
        "python3",
        "trafilatura_mcp.py"
      ],
      "timeout": 600000
    },
    "wayback": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "mcp-wayback-machine"
      ],
      "timeout": 600000
    },
    "wikipedia": {
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "wikipedia-mcp"
      ],
      "timeout": 600000
    },
    "workflow-status": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${REPO_ROOT}/mcp/workflow-status",
        "python",
        "server.py"
      ],
      "env": {
        "WAGENTS_REPO_ROOT": "${REPO_ROOT}"
      },
      "timeout": 600000
    }
  },
  "groups": {
    "all-managed": {
      "name": "all-managed",
      "description": "All enabled servers managed by the repository MCP registry.",
      "servers": [
        "agent-catalog",
        "arxiv",
        "atom-of-thoughts",
        "brave-search",
        "cascade-thinking",
        "chrome-devtools",
        "context7",
        "crash",
        "creative-thinking",
        "deep-lucid-3d",
        "deepwiki",
        "docling",
        "docs-index",
        "duckduckgo-search",
        "eval-results",
        "exa",
        "fetch",
        "fetcher",
        "ffmpeg",
        "g-search",
        "gmail",
        "linkedin",
        "lotus-wisdom-mcp",
        "ossinsight",
        "package-version",
        "penpot",
        "repo-readonly",
        "repomix",
        "sequential-thinking",
        "shannon-thinking",
        "skill-catalog",
        "source-url-health",
        "structured-thinking",
        "supathings",
        "tavily",
        "think-strategies",
        "trafilatura",
        "wayback",
        "wikipedia",
        "template-smoke",
        "ci-artifacts",
        "release-provenance",
        "workflow-status",
        "docs-graph"
      ]
    },
    "browser": {
      "name": "browser",
      "description": "Live browser automation.",
      "servers": [
        "chrome-devtools"
      ]
    },
    "code-intel": {
      "name": "code-intel",
      "description": "Repository and dependency intelligence.",
      "servers": [
        "agent-catalog",
        "repo-readonly",
        "repomix",
        "package-version",
        "ossinsight",
        "skill-catalog"
      ]
    },
    "daily": {
      "name": "daily",
      "description": "Default local workhorse bundle for routine coding and research.",
      "servers": [
        "brave-search",
        "context7",
        "deepwiki",
        "fetch",
        "trafilatura",
        "package-version",
        "repomix"
      ]
    },
    "data-pipeline": {
      "name": "data-pipeline",
      "description": "Heavy document extraction and media transform.",
      "servers": [
        "docling",
        "ffmpeg",
        "trafilatura"
      ]
    },
    "docs": {
      "name": "docs",
      "description": "Library and framework documentation lookup.",
      "servers": [
        "context7",
        "deepwiki",
        "docs-index"
      ]
    },
    "experimental": {
      "name": "experimental",
      "description": "Bleeding-edge search, reasoning, and media servers.",
      "servers": [
        "exa",
        "g-search",
        "atom-of-thoughts",
        "crash",
        "creative-thinking",
        "deep-lucid-3d",
        "lotus-wisdom-mcp",
        "shannon-thinking",
        "think-strategies"
      ]
    },
    "harness-safe": {
      "name": "harness-safe",
      "description": "Shared harness-facing alias of daily; keep membership equal to daily.",
      "servers": [
        "brave-search",
        "context7",
        "deepwiki",
        "fetch",
        "trafilatura",
        "package-version",
        "repomix"
      ]
    },
    "personal": {
      "name": "personal",
      "description": "Account-backed connectors; treat as sensitive.",
      "servers": [
        "gmail",
        "linkedin"
      ]
    },
    "productivity": {
      "name": "productivity",
      "description": "GTD and design tooling.",
      "servers": [
        "supathings",
        "penpot"
      ]
    },
    "read-web": {
      "name": "read-web",
      "description": "URL ingestion without search APIs.",
      "servers": [
        "fetch",
        "fetcher",
        "trafilatura",
        "wayback"
      ]
    },
    "reasoning": {
      "name": "reasoning",
      "description": "Curated structured-thinking servers (three proven tools only).",
      "servers": [
        "sequential-thinking",
        "cascade-thinking",
        "structured-thinking"
      ]
    },
    "references": {
      "name": "references",
      "description": "Academic papers, encyclopedia, and archive lookup.",
      "servers": [
        "arxiv",
        "wikipedia",
        "wayback"
      ]
    },
    "repo-catalog": {
      "name": "repo-catalog",
      "description": "Read-only repo catalog, docs reports, eval gates, and source URL health.",
      "servers": [
        "skill-catalog",
        "agent-catalog",
        "docs-index",
        "repo-readonly",
        "source-url-health",
        "eval-results",
        "template-smoke",
        "ci-artifacts",
        "release-provenance",
        "workflow-status",
        "docs-graph"
      ]
    },
    "search": {
      "name": "search",
      "description": "Stable web search APIs.",
      "servers": [
        "brave-search",
        "tavily",
        "duckduckgo-search"
      ]
    },
    "tunnel": {
      "name": "tunnel",
      "description": "Bounded remote ChatGPT tunnel surface without personal or browser tools.",
      "servers": [
        "brave-search",
        "context7",
        "deepwiki",
        "fetch",
        "trafilatura",
        "package-version",
        "repomix",
        "duckduckgo-search"
      ]
    }
  },
  "systemConfig": {
    "routing": {
      "enableGlobalRoute": true,
      "enableGroupNameRoute": true,
      "enableBearerAuth": true,
      "bearerAuthHeaderName": "Authorization",
      "jsonBodyLimit": "5mb",
      "skipAuth": false
    },
    "smartRouting": {
      "enabled": false,
      "embeddingProvider": "${SMART_ROUTING_EMBEDDING_PROVIDER}",
      "embeddingModel": "${EMBEDDING_MODEL}",
      "progressiveDisclosure": "${SMART_ROUTING_PROGRESSIVE_DISCLOSURE}"
    },
    "toolResultCompression": {
      "enabled": false,
      "minTokens": 2000,
      "maxOutputTokens": 1200,
      "strategy": "auto"
    }
  }
}
