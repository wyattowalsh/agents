{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.w4w.dev/schemas/things-plus-plus/shortcut-response-v1.json",
  "title": "Things++ Shortcut Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "bridgeIdentity",
    "requestSchemaSha256",
    "responseSchemaSha256",
    "requestId",
    "status",
    "result",
    "errorCode",
    "tccReady"
  ],
  "properties": {
    "protocolVersion": {"const": "1"},
    "bridgeIdentity": {
      "enum": ["Things++ Agent Bridge", "Things++ Destructive Bridge"]
    },
    "requestSchemaSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "responseSchemaSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requestId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "status": {"enum": ["ok", "error"]},
    "result": {"type": "object", "maxProperties": 32},
    "errorCode": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "tccReady": {"type": "boolean"}
  }
}
