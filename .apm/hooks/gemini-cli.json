{
  "hooks": {
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook --bundle git-commit-push-guard,image-input-optimizer-guard --harness gemini-cli --bundle-mode enforce-chain --bundle-timeout 65",
            "name": "bundle-fleet-pre-tool-enforce",
            "timeout": 65000,
            "description": "Block force-pushes to protected branches, hook-skipping commits, and unsafe history rewrites across the fleet."
          }
        ],
        "sequential": true,
        "matcher": "Bash|bash|run_shell_command|shell|terminal|analyze_image|attach_image|screenshot|upload_image|view_image|Read|read"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook --bundle research-readonly-write-guard,research-dangerous-shell-guard --harness gemini-cli --bundle-mode enforce-chain --bundle-timeout 10",
            "name": "bundle-research-shell-guards",
            "timeout": 10000,
            "description": "Prevent source-file write tools during active research sessions."
          }
        ],
        "sequential": true,
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|run_shell_command|Bash|bash"
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-prompt-triage-context --harness gemini-cli",
            "name": "research-prompt-triage-context",
            "timeout": 5000,
            "description": "Activate research hook state and inject research-method reminders."
          }
        ],
        "sequential": true
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-evidence-ledger --harness gemini-cli",
            "name": "research-evidence-ledger",
            "timeout": 5000,
            "description": "Append lightweight provenance metadata for research retrieval tools."
          }
        ],
        "sequential": true,
        "matcher": "WebSearch|web_search|fetch|fetcher|trafilatura|docling|mcp__.*|mcp_.*"
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-stop-verifier --harness gemini-cli",
            "name": "research-stop-verifier",
            "timeout": 30000,
            "description": "Verify research skill invariants before an active research session completes."
          }
        ],
        "sequential": true
      }
    ]
  }
}
