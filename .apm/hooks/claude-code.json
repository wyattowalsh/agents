{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook --bundle destructive-shell-guard,protected-file-guard,git-commit-push-guard,image-input-optimizer-guard --harness claude-code --bundle-mode enforce-chain --bundle-timeout 75",
            "timeout": 75
          }
        ],
        "matcher": "Bash|bash|run_shell_command|Shell|Edit|Write|MultiEdit|edit|create|write_file|replace|shell|terminal|analyze_image|attach_image|screenshot|upload_image|view_image|Read|read"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook --bundle research-readonly-write-guard,research-dangerous-shell-guard --harness claude-code --bundle-mode enforce-chain --bundle-timeout 10",
            "timeout": 10
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|run_shell_command|Bash|bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-prompt-triage-context --harness claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-evidence-ledger --harness claude-code",
            "timeout": 5
          }
        ],
        "matcher": "WebSearch|web_search|fetch|fetcher|trafilatura|docling|mcp__.*|mcp_.*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-stop-verifier --harness claude-code",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/verify-before-stop.sh",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/task-completed-gate.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/teammate-idle-gate.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
