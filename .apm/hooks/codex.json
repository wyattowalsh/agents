{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook codex-session-start-context --harness codex",
            "timeout": 5,
            "statusMessage": "Gathering Codex session context"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook --bundle codex-destructive-shell-guard,codex-protected-file-guard,git-commit-push-guard,image-input-optimizer-guard --harness codex --bundle-mode enforce-chain --bundle-timeout 75",
            "timeout": 75,
            "statusMessage": "Checking shell safety"
          }
        ],
        "matcher": "Bash|bash|run_shell_command|shell|terminal|Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|analyze_image|attach_image|screenshot|upload_image|view_image|Read|read"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook --bundle research-readonly-write-guard,research-dangerous-shell-guard --harness codex --bundle-mode enforce-chain --bundle-timeout 10",
            "timeout": 10,
            "statusMessage": "Prevent source-file write tools during active research sessions."
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|run_shell_command|Bash|bash"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook codex-permission-request-guard --harness codex",
            "timeout": 5,
            "statusMessage": "Checking approval request safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook codex-post-tool-verify-context --harness codex",
            "timeout": 5,
            "statusMessage": "Checking post-edit quality"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|Bash|bash|run_shell_command"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-evidence-ledger --harness codex",
            "timeout": 5,
            "statusMessage": "Append lightweight provenance metadata for research retrieval tools."
          }
        ],
        "matcher": "WebSearch|web_search|fetch|fetcher|trafilatura|docling|mcp__.*|mcp_.*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook codex-stop-truth-gate --harness codex",
            "timeout": 5,
            "statusMessage": "Checking final-answer evidence"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-stop-verifier --harness codex",
            "timeout": 30,
            "statusMessage": "Verify research skill invariants before an active research session completes."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-prompt-triage-context --harness codex",
            "timeout": 5,
            "statusMessage": "Activate research hook state and inject research-method reminders."
          }
        ]
      }
    ]
  }
}
