          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": [
            "string",
            "null"
          ]
        },
        "time": {
          "type": [
            "string",
            "null"
          ]
        },
        "risk": {
          "enum": [
            "critical",
            "high",
            "low",
            "medium",
            "unknown",
            null
          ]
        },
        "approval_tier": {
          "enum": [
            "critical",
            "high",
            "low",
            "medium",
            "unknown",
            null
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependency_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repercussions": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "patternProperties": {
        ".*_bytes$": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": true
    },
    "duplicate": {
