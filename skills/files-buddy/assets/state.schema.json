{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wyattowalsh.github.io/agents/files-buddy/state.schema.json",
  "title": "Files Buddy canonical execution state v2",
  "description": "One authoritative state per run. Structural validation is not consent or filesystem verification. The trusted invoker must pass the exact approved digest at execution time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "updated_at",
    "status",
    "plan",
    "plan_digest",
    "approval",
    "operations",
    "undo"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "completed",
        "partial",
        "failed",
        "undone"
      ]
    },
    "plan": {
      "$ref": "https://wyattowalsh.github.io/agents/files-buddy/plan.schema.json"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_digest",
            "received_at",
            "source"
          ],
          "properties": {
            "plan_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "received_at": {
              "type": "string",
              "format": "date-time"
            },
            "source": {
              "const": "trusted-invoker-cli"
            }
          }
        }
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "undo": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "plan_digest",
            "approval",
            "operations"
          ],
          "properties": {
            "plan": {
              "$ref": "https://wyattowalsh.github.io/agents/files-buddy/plan.schema.json"
            },
            "plan_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "approval": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "plan_digest",
                    "received_at",
                    "source"
                  ],
                  "properties": {
                    "plan_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "received_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "source": {
                      "const": "trusted-invoker-cli"
                    }
                  }
                }
              ]
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "$ref": "#/$defs/record"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "status",
        "updated_at",
        "after",
        "error"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        },
        "status": {
          "enum": [
            "planned",
            "prepared",
            "applied",
            "verified",
            "failed",
            "uncertain",
            "conflict"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "after": {
          "anyOf": [
            {
              "$ref": "https://wyattowalsh.github.io/agents/files-buddy/plan.schema.json#/$defs/snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "after": {
                "$ref": "https://wyattowalsh.github.io/agents/files-buddy/plan.schema.json#/$defs/snapshot"
              }
            }
          }
        }
      ]
    }
  }
}
