{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook codex-session-start-context --harness codex",
            "timeout": 5,
            "statusMessage": "Gathering Codex session context"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook codex-destructive-shell-guard --harness codex",
            "timeout": 5,
            "statusMessage": "Checking shell safety"
          }
        ],
        "matcher": "Bash|bash|run_shell_command|shell|terminal"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook codex-protected-file-guard --harness codex",
            "timeout": 5,
            "statusMessage": "Checking protected paths"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|Bash|bash|run_shell_command"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook git-commit-push-guard --harness codex",
            "timeout": 5,
            "statusMessage": "Checking git commit/push safety"
          }
        ],
        "matcher": "Bash|bash|run_shell_command|shell|terminal"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook image-input-optimizer-guard --harness codex",
            "timeout": 60,
            "statusMessage": "Optimizing image inputs"
          }
        ],
        "matcher": "analyze_image|attach_image|screenshot|upload_image|view_image|Read|read|.*[Ii]mage.*|.*[Vv]ision.*|.*[Ss]creenshot.*|.*[Aa]ttach.*|.*[Uu]pload.*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-readonly-write-guard --harness codex",
            "timeout": 5,
            "statusMessage": "Prevent source-file write tools during active research sessions."
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|run_shell_command"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-dangerous-shell-guard --harness codex",
            "timeout": 5,
            "statusMessage": "Block dangerous shell side effects during active research sessions."
          }
        ],
        "matcher": "Bash|bash|run_shell_command"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook codex-permission-request-guard --harness codex",
            "timeout": 5,
            "statusMessage": "Checking approval request safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook codex-post-tool-verify-context --harness codex",
            "timeout": 5,
            "statusMessage": "Checking post-edit quality"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch|edit|create|replace|write_file|Bash|bash|run_shell_command"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-evidence-ledger --harness codex",
            "timeout": 5,
            "statusMessage": "Append lightweight provenance metadata for research retrieval tools."
          }
        ],
        "matcher": "WebSearch|web_search|fetch|fetcher|trafilatura|docling|mcp__.*|mcp_.*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook codex-stop-truth-gate --harness codex",
            "timeout": 5,
            "statusMessage": "Checking final-answer evidence"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-stop-verifier --harness codex",
            "timeout": 30,
            "statusMessage": "Verify research skill invariants before an active research session completes."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/run-wagents-hook research-prompt-triage-context --harness codex",
            "timeout": 5,
            "statusMessage": "Activate research hook state and inject research-method reminders."
          }
        ]
      }
    ]
  }
}
