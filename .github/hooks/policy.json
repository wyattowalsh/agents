{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./hooks/session-start.sh",
        "cwd": ".",
        "timeoutSec": 15,
        "comment": "Report basic session environment and repository state."
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "./hooks/log-prompt.sh",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Write local prompt audit entries with short retention."
      },
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook research-prompt-triage-context --harness github-copilot",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Activate research hook state and inject research-method reminders."
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "./hooks/auto-format.sh",
        "cwd": ".",
        "timeoutSec": 60,
        "comment": "Run best-effort formatter after edits."
      },
      {
        "type": "command",
        "bash": "./hooks/lint-check.sh",
        "cwd": ".",
        "timeoutSec": 30,
        "comment": "Return concise lint/type context after edits."
      },
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook research-evidence-ledger --harness github-copilot",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Append lightweight provenance metadata for research retrieval tools."
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook destructive-shell-guard --harness github-copilot",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Block high-risk shell commands."
      },
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook protected-file-guard --harness github-copilot",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Block edits to protected paths and secret-bearing files."
      },
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook git-commit-push-guard --harness github-copilot",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Block force-pushes to protected branches, hook-skipping commits, and unsafe history rewrites across the fleet."
      },
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook image-input-optimizer-guard --harness github-copilot",
        "cwd": ".",
        "timeoutSec": 60,
        "comment": "Resize and compress oversized local image inputs before harnesses consume them."
      },
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook research-readonly-write-guard --harness github-copilot",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Prevent source-file write tools during active research sessions."
      },
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook research-dangerous-shell-guard --harness github-copilot",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Block dangerous shell side effects during active research sessions."
      }
    ]
  }
}
