{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./hooks/session-start.sh",
        "cwd": ".",
        "timeoutSec": 15,
        "comment": "Report basic session environment and repository state."
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "./hooks/log-prompt.sh",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Write local prompt audit entries with short retention."
      },
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook research-prompt-triage-context --harness github-copilot",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Activate research hook state and inject research-method reminders."
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "./hooks/post-edit-quality.sh",
        "cwd": ".",
        "timeoutSec": 90,
        "comment": "Run best-effort formatter after edits."
      },
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook research-evidence-ledger --harness github-copilot",
        "cwd": ".",
        "timeoutSec": 5,
        "comment": "Append lightweight provenance metadata for research retrieval tools."
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook --bundle destructive-shell-guard,protected-file-guard,git-commit-push-guard,image-input-optimizer-guard --harness github-copilot --bundle-mode enforce-chain --bundle-timeout 75",
        "cwd": ".",
        "timeoutSec": 75,
        "comment": "Block high-risk shell commands."
      },
      {
        "type": "command",
        "bash": "./hooks/run-wagents-hook --bundle research-readonly-write-guard,research-dangerous-shell-guard --harness github-copilot --bundle-mode enforce-chain --bundle-timeout 10",
        "cwd": ".",
        "timeoutSec": 10,
        "comment": "Prevent source-file write tools during active research sessions."
      }
    ]
  }
}
