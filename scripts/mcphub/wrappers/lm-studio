#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
"${SCRIPT_DIR}/ensure-running.sh"

if [[ "$(uname -s)" == "Darwin" ]]; then
  exec open -a "LM Studio" --args "$@"
fi

if command -v lm-studio >/dev/null 2>&1; then
  exec "${MCPHUB_WRAPPED_LM_STUDIO:-lm-studio}" "$@"
fi

printf 'LM Studio app not found (open -a "LM Studio" / lm-studio).\n' >&2
exit 1
